<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stock.price-alerts</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/user/Documents/invest/.venv/bin/python3</string>
        <string>/Users/user/Documents/invest/price_alerts.py</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/Users/user/Library/Logs/stock-monitor/alerts-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/Library/Logs/stock-monitor/alerts-stderr.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/user/Documents/invest</string>
</dict>
</plist>
