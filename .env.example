# potato-fin 환경변수 템플릿
# 실제 사용: 이 파일을 .env 로 복사 (cp .env.example .env) 후 값 채우기
# .env 파일은 .gitignore 로 git 추적 제외됨

# ───────────────────────────────────────────────────
# Telegram (기존)
# ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ───────────────────────────────────────────────────
# Notion (로그인 없이 cron 작동)
# ───────────────────────────────────────────────────
# 1. https://www.notion.so/my-integrations 접속
# 2. "New integration" → name: "potato-fin-reports", type: Internal
# 3. Secret 복사 (ntn_ 로 시작)
# 4. Notion DB 페이지 (https://www.notion.so/b63e9e1bfca34492bbda0268ef2eb599)
#    우측 상단 ⋯ → Connections → "potato-fin-reports" 추가
# 5. 아래 두 값 채움
NOTION_TOKEN=ntn_your_integration_secret_here
NOTION_DATABASE_ID=b63e9e1b-fca3-4492-bbda-0268ef2eb599

# ───────────────────────────────────────────────────
# (선택) 추가 API
# ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...  # Claude API 직접 호출 시
# FINNHUB_API_KEY=...           # 뉴스 API (무료 tier)
# ALPHA_VANTAGE_KEY=...         # 시장 데이터 보완
# KIS_APP_KEY=...               # 한국투자증권 API (자동매매용)
# KIS_APP_SECRET=...
